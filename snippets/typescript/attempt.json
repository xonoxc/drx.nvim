{
  "AttemptAsyncCall": {
    "prefix": "ata",
    "body": [
      "const ${1:result} = await attempt(${2:asyncCall});",
      "if (!${1:result}.ok) {",
      "  const error = ${1:result}.error;",
      "  // handle error",
      "  return;",
      "}",
      "const data = ${1:result}.data;",
      "// handle success"
    ],
    "description": "Attempt async call with early return error handling"
  },
  "AttemptSyncCall": {
    "prefix": "ats",
    "body": [
      "const ${1:result} = attemptSync(${2:fn});",
      "if (!${1:result}.ok) {",
      "  const error = ${1:result}.error;",
      "  // handle error",
      "  return;",
      "}",
      "const data = ${1:result}.data;",
      "// handle success"
    ],
    "description": "Attempt sync call with early return error handling"
  },
  "HandleAxiosError": {
    "prefix": "hae",
    "body": [
      "if (error instanceof AxiosError) {",
      "  const handledError = handleAxiosError(error);",
      "  if (handledError) {",
      "    // Process handled error",
      "    console.error(handledError.status, handledError.message);",
      "    return;",
      "  }",
      "}",
      "// fallback error handling"
    ],
    "description": "Handle axios error with early return"
  }
}
