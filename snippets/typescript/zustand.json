{
  "CreateStore": {
    "prefix": "zs",
    "body": [
      "import { create } from 'zustand';",
      "",
      "interface ${1:State} {",
      "  ${2:key}: ${3:type};",
      "  set${2/(.*)/${1:/capitalize}/} : (${2}: ${3:type}) => void;",
      "}",
      "",
      "export const use${1/(.*)/${1:/capitalize}/}Store = create<${1:State}>((set) => ({",
      "  ${2}: ${4:value},",
      "  set${2/(.*)/${1:/capitalize}/}: (${2}) => set(() => ({ ${2} }))",
      "}));"
    ],
    "description": "Create a basic Zustand store with setter"
  },
  "UseStoreValue": {
    "prefix": "zv",
    "body": [
      "const ${1:value} = use${2:Store}((state) => state.${3:property});"
    ],
    "description": "Read a value from a Zustand store"
  },
  "CallStoreSetter": {
    "prefix": "zsx",
    "body": [
      "const set${1:Property} = use${2:Store}((state) => state.set${1:Property});",
      "set${1:Property}(${3:value});"
    ],
    "description": "Call Zustand store setter"
  },
  "PersistedStore": {
    "prefix": "zsp",
    "body": [
      "import { create } from 'zustand';",
      "import { persist } from 'zustand/middleware';",
      "",
      "export const use${1:Store} = create(persist((set) => ({",
      "  ${2:key}: ${3:type},",
      "  set${2/(.*)/${1:/capitalize}/}: (${2}) => set(() => ({ ${2} }))",
      "}), {",
      "  name: '${1:store}-storage',",
      "}));"
    ],
    "description": "Create a persisted Zustand store"
  }
}
