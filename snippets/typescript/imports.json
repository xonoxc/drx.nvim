{
  "ImportNamed": {
    "prefix": "imn",
    "body": ["import { ${1:NamedImport} } from '${2:module}';"],
    "description": "Import named export from a module"
  },
  "ImportDefault": {
    "prefix": "imd",
    "body": ["import ${1:defaultExport} from '${2:module}';"],
    "description": "Import default export from a module"
  },
  "ImportAll": {
    "prefix": "ima",
    "body": ["import * as ${1:alias} from '${2:module}';"],
    "description": "Import all exports as alias"
  },
  "ImportType": {
    "prefix": "imt",
    "body": ["import type { ${1:TypeName} } from '${2:module}';"],
    "description": "Type-only import (TypeScript)"
  },
  "Require": {
    "prefix": "req",
    "body": ["const ${1:module} = require('${2:module}');"],
    "description": "CommonJS require import"
  }
}
